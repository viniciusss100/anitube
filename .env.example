PORT=7000
PUBLIC_URL=https://seu-dominio.com
# Opcional: TMDB para enriquecer posters (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
# Opcional: bases alternativas do AniTube (vírgula)
ANITUBE_BASES=https://www.anitube.zip,https://www.anitube.news
# Opcional: proxy Kitsu público
KITSU_BASE_URL=https://kitsufortheweebs.midnightignite.me
# Proxy externo para contornar bloqueio de IP do provedor (ex: http://user:pass@host:port ou http://host:port)
# Vazio = sem proxy (usa IP direto). Aplica-se a todas as requisições do scraper.
SCRAPE_PROXY=
# Fallback do scraper quando o IP direto é bloqueado (403/429) — CORS/relay proxies.
# Use {url} como placeholder do alvo. Vazio desabilita o fallback.
SCRAPE_CORS_PROXIES=https://api.allorigins.win/raw?url={url},https://corsproxy.io/?url={url}
# Express trust proxy: true / false / <nº de hops> (default: 1 em produção/Render)
TRUST_PROXY=
# Tuning
CACHE_TTL_MS=120000
CACHE_MAX_KEYS=1000
HOME_TTL_MS=60000
HTTP_TIMEOUT_MS=8000
SCRAPER_TIMEOUT_MS=15000
LOG_LEVEL=info
# Proxy segurança
PROXY_ALLOWED_DOMAINS=anitube.news,anitube.zip,anitube.site,blogger.com,googlevideo.com,anivideo.net,blogspot.com,googleusercontent.com
PROXY_BLOCK_PRIVATE_IPS=true
